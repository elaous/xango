//go:build js && wasm

package main

import (
	"net/url"
	"syscall/js"

	"github.com/elaous/xango/domrt/browser"
	"github.com/elaous/xango/domrt/html"
)

func render(document *html.Document, u *url.URL) {
	content := "Home page"
	if u.Path == "/about" {
		content = "About page"
	}
	document.GetElementByID("content").SetTextContent(content)
	document.GetElementByID("path-result").SetTextContent(u.Path)
}

func onClick(fn func()) js.Func {
	return js.FuncOf(func(this js.Value, args []js.Value) any {
		fn()
		return nil
	})
}

func main() {
	document := browser.Document()
	router := browser.NewRouter()

	router.OnNavigate(func(u *url.URL) { render(document, u) })

	document.GetElementByID("go-about").AddEventListener("click", onClick(func() {
		router.Navigate("/about")
	}))
	document.GetElementByID("replace-home").AddEventListener("click", onClick(func() {
		router.Replace("/")
	}))

	render(document, router.URL())

	select {} // keep the wasm program alive for the popstate/click listeners above
}
