// Package main demos resource imports: a JSON config file decoded
// directly into a struct you declare yourself (config.(SiteConfig)
// tells gox to decode into SiteConfig -- gox doesn't generate or
// infer it, so any shape you can declare in Go works), and a CSS
// file's content injected into a page, both bound directly from the
// .gox import block instead of a separate go:embed + read-file dance.
package main

import (
	"fmt"
	"os"

	config.(SiteConfig) "config.json"
	"style.css"

	"github.com/elaous/gojiberry/gox"
)

type SiteConfig struct {
	Title string `json:"title"`
}

func Page(cfg SiteConfig) gox.Node {
	return <html>
		<head><style>{gox.Raw(style_css)}</style></head>
		<body><h1>{cfg.Title}</h1></body>
	</html>
}

func main() {
	if err := gox.Render(os.Stdout, Page(config)); err != nil {
		fmt.Fprintln(os.Stderr, "render error:", err)
		os.Exit(1)
	}
	fmt.Println()
}
