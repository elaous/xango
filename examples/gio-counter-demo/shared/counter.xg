package shared

import (
	"strconv"

	"github.com/elaous/xango"
)

type CounterProps struct {
	Count int
	OnInc xango.EventHandler
	OnDec xango.EventHandler
}

func Counter(props CounterProps) xango.Node {
	return <div id="counter" data-axis="horizontal">
		<button id="dec" onClick={props.OnDec}>-</button>
		<span id="count">{strconv.Itoa(props.Count)}</span>
		<button id="inc" onClick={props.OnInc}>+</button>
	</div>
}
