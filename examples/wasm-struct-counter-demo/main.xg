//go:build js && wasm

package main

import (
	"strconv"
	"syscall/js"

	"github.com/elaous/gojiberry/domrt"
	"github.com/elaous/gojiberry/xango"
)

type CounterProps struct {
	Count int
	OnInc xango.EventHandler
	OnDec xango.EventHandler
}

func Counter(props CounterProps) xango.Node {
	return counter{props}.Render()
}

type counter struct {
	Props CounterProps
}

// Label describes the current count in words.
func (c counter) Label() string {
	parity := "even"
	if c.Props.Count%2 != 0 {
		parity = "odd"
	}
	return strconv.Itoa(c.Props.Count) + " (" + parity + ")"
}

func (c counter) Render() xango.Node {
	return <div id="counter">
		<button id="dec" onClick={c.Props.OnDec}>-</button>
		<span id="count">{c.Label()}</span>
		<button id="inc" onClick={c.Props.OnInc}>+</button>
	</div>
}

func main() {
	count := 0
	container := js.Global().Get("document").Call("getElementById", "app")

	var root *domrt.Root
	var render func()
	render = func() {
		node := <Counter
			count={count}
			onInc={func(xango.Event) { count++; render() }}
			onDec={func(xango.Event) { count--; render() }}
		/>
		if root == nil {
			root = domrt.Mount(container, node)
		} else {
			root.Update(node)
		}
	}
	render()

	select {} // keep the wasm program alive so event callbacks keep firing
}
