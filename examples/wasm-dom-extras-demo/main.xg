//go:build js && wasm

package main

import (
	"fmt"
	"strings"
	"syscall/js"

	"github.com/elaous/xango/domrt/browser"
	"github.com/elaous/xango/domrt/html"
	"github.com/elaous/xango/domrt/svg"
)

const tinyPNG = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAADCAIAAAA7ljmRAAAAGElEQVR4nGI5wWDEAANMDEgAhQMIAAD//yXJAQO5Nc3AAAAAAElFTkSuQmCC"

func main() {
	document := browser.Document()
	window := browser.Window()

	// Window/Document dimensions.
	document.GetElementByID("window-result").SetTextContent(
		fmt.Sprintf("innerWidth>0=%v innerHeight>0=%v dpr>0=%v",
			window.InnerWidth() > 0, window.InnerHeight() > 0, window.DevicePixelRatio() > 0))
	document.GetElementByID("document-result").SetTextContent(
		fmt.Sprintf("docElClientHeight>0=%v bodyClientWidth>0=%v",
			document.DocumentElement().ClientHeight() > 0, document.Body().ClientWidth() > 0))

	scrollbox := document.GetElementByID("scrollbox")
	scrollHeight := scrollbox.ScrollHeight()
	clientHeight := scrollbox.ClientHeight()
	scrollbox.SetScrollTop(30)
	document.GetElementByID("scroll-result").SetTextContent(
		fmt.Sprintf("scrollHeight>clientHeight=%v scrollTop=%d", scrollHeight > clientHeight, scrollbox.ScrollTop()))

	// Style: inline get/set, CSSText, and a real computed style.
	styled := document.GetElementByID("styled")
	styled.SetStyleProperty("color", "rgb(10, 20, 30)")
	styled.Style().Set("font-weight", "bold")
	computed := window.ComputedStyle(styled)
	document.GetElementByID("style-result").SetTextContent(
		fmt.Sprintf("color=%s cssTextHasBold=%v computedDisplay=%s",
			styled.StyleProperty("color"),
			strings.Contains(styled.Style().CSSText(), "bold"),
			computed.Get("display")))

	svgContainer := document.GetElementByID("svg-container")
	svgEl := svg.CreateElement(document, "svg")
	svgEl.SetAttribute("width", "100")
	svgEl.SetAttribute("height", "100")
	circle := svg.CreateElement(document, "circle")
	circle.SetAttribute("cx", "50")
	circle.SetAttribute("cy", "50")
	circle.SetAttribute("r", "40")
	circle.SetAttribute("fill", "blue")
	circle.ClassListAdd("my-circle")
	svgEl.AppendChild(circle)
	svgContainer.AppendChild(svgEl)
	rect := circle.BoundingRect()
	document.GetElementByID("svg-result").SetTextContent(
		fmt.Sprintf("fill=%s rendered=%v hasClass=%v",
			circle.GetAttribute("fill"), rect.Width > 0 && rect.Height > 0, circle.ClassListContains("my-circle")))

	imgEl := document.CreateElement("img")
	img := imgEl.AsImage()
	img.OnLoad(func() {
		document.GetElementByID("image-result").SetTextContent(
			fmt.Sprintf("complete=%v naturalWidth=%d naturalHeight=%d", img.Complete(), img.NaturalWidth(), img.NaturalHeight()))
	})
	img.SetSrc(tinyPNG)
	document.GetElementByID("image-container").AppendChild(imgEl)

	form := document.GetElementByID("demo-form").AsForm()
	form.OnSubmit(func(evt html.SubmitEvent) {
		evt.PreventDefault()
		fd := browser.NewFormDataFromForm(form)
		fd.Append("extra", "added-field")
		document.GetElementByID("form-result").SetTextContent(
			fmt.Sprintf("title=%s hasDoc=%v extra=%s", fd.Get("title"), fd.Has("doc"), fd.Get("extra")))
	})

	browser.Cookies.Set("demo", "hello world! a=b;c", browser.CookieOptions{Path: "/"})
	cookieValue, cookieOK := browser.Cookies.Get("demo")
	document.GetElementByID("cookie-result").SetTextContent(
		fmt.Sprintf("value=%s ok=%v", cookieValue, cookieOK))

	ceTarget := document.GetElementByID("customevent-target")
	ceTarget.OnCustomEvent("demo-event", func(detail js.Value) {
		document.GetElementByID("customevent-result").SetTextContent("received: " + detail.String())
	})
	ceTarget.DispatchCustomEvent("demo-event", "hello from custom event", true)

	window.OnError(func(err *html.JSError) {
		document.GetElementByID("jserror-result").SetTextContent("message=" + err.Message)
	})
	window.OnUnhandledRejection(func(err *html.JSError) {
		document.GetElementByID("rejection-result").SetTextContent("message=" + err.Message)
	})

	fixture := document.GetElementByID("query-fixture")
	chosen := fixture.QuerySelector(".item.chosen")
	chosenText := "(nil)"
	if chosen != nil {
		chosenText = chosen.GetTextContent()
	}
	docWide := len(document.QuerySelectorAll(".item"))
	scoped := len(fixture.QuerySelectorAll(".item"))
	noMatch := fixture.QuerySelector(".does-not-exist") == nil
	voidScoped := document.GetElementByID("title-input").QuerySelector("*") == nil
	document.GetElementByID("query-result").SetTextContent(
		fmt.Sprintf("chosen=%s docWide=%d scoped=%d noMatchIsNil=%v voidHasNoDescendants=%v",
			chosenText, docWide, scoped, noMatch, voidScoped))

	go func() {
		pos, err := browser.CurrentPosition()
		if err != nil {
			document.GetElementByID("geo-result").SetTextContent("error: " + err.Error())
			return
		}
		document.GetElementByID("geo-result").SetTextContent(
			fmt.Sprintf("lat=%.4f lng=%.4f", pos.Latitude, pos.Longitude))
	}()

	select {} // keep the wasm program alive for every listener above
}
