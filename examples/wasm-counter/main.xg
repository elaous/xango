//go:build js && wasm

package main

import (
	"strconv"
	"syscall/js"

	"github.com/elaous/gojiberry/domrt"
	"github.com/elaous/gojiberry/xango"
)

type CounterProps struct {
	Count int
	OnInc xango.EventHandler
	OnDec xango.EventHandler
}

func Counter(props CounterProps) xango.Node {
	return <div id="counter">
		<button id="dec" onClick={props.OnDec}>-</button>
		<span id="count">{strconv.Itoa(props.Count)}</span>
		<button id="inc" onClick={props.OnInc}>+</button>
	</div>
}

func main() {
	count := 0
	container := js.Global().Get("document").Call("getElementById", "app")

	var root *domrt.Root
	var render func()
	render = func() {
		node := Counter(CounterProps{
			Count: count,
			OnInc: func(xango.Event) { count++; render() },
			OnDec: func(xango.Event) { count--; render() },
		})
		if root == nil {
			root = domrt.Mount(container, node)
		} else {
			root.Update(node)
		}
	}
	render()

	select {} // keep the wasm program alive so event callbacks keep firing
}
